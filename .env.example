# ==============================================================================
# Production Cloud Deployment Configuration
# ==============================================================================

# Your public domain (e.g. ym2sc.com or music-transfer.ru)
# Caddy will automatically issue a free trusted Let's Encrypt SSL certificate!
PUBLIC_DOMAIN=yourdomain.com

# Dual-Routing Proxies (Optional)
# If your server is in Europe (e.g. Hetzner, DigitalOcean), set a Russian proxy for Yandex Music:
# YM_PROXY=http://user:password@ru-proxy.com:8080

# If your server is in Russia (e.g. Timeweb, Selectel), set a foreign proxy for SoundCloud (if blocked):
# SC_PROXY=http://user:password@eu-proxy.com:8080
